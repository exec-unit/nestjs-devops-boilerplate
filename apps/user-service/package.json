{
  "name": "@nestjs-devops-boilerplate/user-service",
  "version": "1.0.0",
  "description": "Base user management microservice template built with NestJS.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --enable-source-maps dist/main.js",
    "build": "swc src -d dist --strip-leading-paths",
    "dev:build": "swc src -d dist --strip-leading-paths -w",
    "lint": "eslint \"src/**/*.ts\"",
    "start:dev": "concurrently -k \"pnpm run dev:build\" \"wait-on dist/main.js && node --enable-source-maps --watch --env-file-if-exists=.env dist/main.js\"",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "bullmq": "^6.0.5",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.1",
    "@testcontainers/redis": "^12.1.0",
    "@types/express": "^5.0.0",
    "@types/supertest": "^7.0.0",
    "axios": "^1.19.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "testcontainers": "^12.1.0",
    "wait-on": "^9.1.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "@swc/jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
